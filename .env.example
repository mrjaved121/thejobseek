# Copy to .env.local (local) or add in Vercel/DigitalOcean environment settings.

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://thejobseek.com

# Google AdSense publisher ID (leave empty until approved; ad slots stay hidden)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: ad unit slot IDs created in AdSense (leave empty to rely on Auto ads)
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_INARTICLE=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (content="..." value only)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta-tag verification code (content="..." value only)
BING_SITE_VERIFICATION=

# Shown on Contact / About pages
NEXT_PUBLIC_CONTACT_EMAIL=contact@thejobseek.com
NEXT_PUBLIC_WHATSAPP_CHANNEL=
NEXT_PUBLIC_TIKTOK=https://www.tiktok.com/@thejobseek
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/thejobseek
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/thejobseek
